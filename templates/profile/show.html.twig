{% extends 'base.html.twig' %}

{% block title %}My Profile – {{ parent() }}{% endblock %}

{% block body %}
<div class="container">
    <div class="profile-header">
        <div class="avatar">{{ user.fullName | initials }}</div>
        <div>
            <h1>{{ user.fullName }}</h1>
            <p class="text-muted">{{ user.email }}</p>
        </div>
    </div>

    <dl class="profile-details">
        <dt>Roles</dt>
        <dd>{{ user.roles | join(', ') }}</dd>

        <dt>Account created</dt>
        <dd>{{ user.createdAt | date('d/m/Y') }}</dd>

        {% if user.lastLoginAt %}
            <dt>Last login</dt>
            <dd>{{ user.lastLoginAt | date('d/m/Y H:i') }}</dd>
        {% endif %}

        <dt>Email verified</dt>
        <dd>{{ user.isVerified ? '✅ Yes' : '❌ No' }}</dd>
    </dl>

    <a href="{{ path('app_profile_edit') }}" class="btn">Edit Profile</a>
</div>
{% endblock %}
