{% extends 'base.html.twig' %}

{% block title %}Change Password – {{ parent() }}{% endblock %}

{% block body %}
<div class="container">
    <h1>Change Password</h1>

    {{ form_start(form, {attr: {class: 'form-card'}}) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.newPassword.first) }}
        {{ form_row(form.newPassword.second) }}

        <div class="form-actions">
            <button type="submit" class="btn">Update Password</button>
            <a href="{{ path('app_profile_show') }}" class="btn btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
