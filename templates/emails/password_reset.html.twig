{% extends 'emails/base_email.html.twig' %}

{% block subject %}Reset your password{% endblock %}

{% block content %}
    <p>Hi {{ user.fullName }},</p>
    <p>We received a request to reset your password. Click the button below to choose a new one.</p>
    <p>
        <a href="{{ url('app_reset_password', {token: resetToken}) }}" class="btn">Reset Password</a>
    </p>
    <p>This link expires on <strong>{{ expiresAt|date('d/m/Y H:i') }}</strong>.</p>
    <p>If you did not request a password reset, you can safely ignore this email.</p>
    <p>— The {{ app_name }} Team</p>
{% endblock %}
