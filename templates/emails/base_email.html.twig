<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block subject %}Email{% endblock %}</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f4f5; margin: 0; padding: 0; }
        .wrapper { max-width: 600px; margin: 2rem auto; }
        .card { background: #ffffff; border-radius: 8px; padding: 2rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
        .header { text-align: center; padding-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; margin-bottom: 1.5rem; }
        .header h1 { color: #4f46e5; margin: 0; font-size: 1.5rem; }
        .btn { display: inline-block; background: #4f46e5; color: #fff !important; text-decoration: none; padding: .75rem 1.5rem; border-radius: 6px; font-weight: 600; margin: 1rem 0; }
        .footer { text-align: center; color: #6b7280; font-size: .8rem; margin-top: 1.5rem; }
        p { color: #374151; line-height: 1.6; }
    </style>
</head>
<body>
<div class="wrapper">
    <div class="card">
        <div class="header">
            <h1>{{ app_name }}</h1>
        </div>
        {% block content %}{% endblock %}
    </div>
    <div class="footer">
        <p>© {{ 'now'|date('Y') }} {{ app_name }}. All rights reserved.</p>
        <p>This email was sent to {{ user.email }}.</p>
    </div>
</div>
</body>
</html>
