<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}{{ app_name ?? 'Symfony App' }}{% endblock %}">

    <title>{% block title %}{{ app_name ?? 'Symfony App' }}{% endblock %}</title>

    {# Favicon #}
    <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">

    {# Styles #}
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}

    {# Open Graph #}
    {% block opengraph %}{% endblock %}
</head>
<body class="{{ block('body_class') | default('') }}">

{% block navbar %}
    {{ include('partials/navbar.html.twig') }}
{% endblock %}

{% block flash_messages %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}

<main>
    {% block body %}{% endblock %}
</main>

{% block footer %}
    <footer>
        <p>&copy; {{ 'now' | date('Y') }} {{ app_name ?? 'Symfony App' }}</p>
    </footer>
{% endblock %}

{% block javascripts %}{% endblock %}

</body>
</html>
