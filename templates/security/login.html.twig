{% extends 'base.html.twig' %}

{% block title %}Login - {{ parent() }}{% endblock %}

{% block body %}
<div class="container">
    <h1>Please sign in</h1>

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey | trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post">
        <div>
            <label for="inputEmail">Email</label>
            <input type="email" id="inputEmail" name="_username" value="{{ last_username }}" required autofocus autocomplete="email">
        </div>

        <div>
            <label for="inputPassword">Password</label>
            <input type="password" id="inputPassword" name="_password" required autocomplete="current-password">
        </div>

        <div>
            <label>
                <input type="checkbox" name="_remember_me"> Remember me
            </label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Sign in</button>
    </form>
</div>
{% endblock %}
